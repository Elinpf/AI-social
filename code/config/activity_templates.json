      "template_id": "mentorship",
      "census_class": "E1_mentorship",
      "activity_type": "learn",
      "place_allowed": ["school", "workshop", "library"],
      "slot_allowed": ["morning", "afternoon"],
      "participants": {"min": 2, "max": 2, "roles": ["mentor", "mentee"]},
      "preconditions": {
        "skill": [{"who": "mentor", "same_skill": true, "gap_op": ">=", "gap_val": 2}],
        "relation": [{"between": ["mentor", "mentee"], "dim": "affinity", "op": ">=", "val": 20}],
        "need": [{"who": "mentee", "dim": "mastery", "op": ">=", "val": 20}],
        "open_slot": true, "place_capacity": true
      },
      "deterministic_settlement": {
        "hook": "L3.settle_activities",
        "effects": {
          "skill": [{"target": "mentee", "skill_id": "*", "delta_levels": 1, "emit": ["SKILL_PRACTICE", "SKILL_LEVEL_UP"]}],
          "need": [{"who": "mentee", "dim": "mastery", "delta": 6}, {"who": "mentor", "dim": "esteem", "delta": 4}],
          "relation": [{"from": "mentee", "to": "mentor", "dim": "respect", "delta": 5}]
        }
      },
      "outputs": {"resource_intents": [], "memory": {"kind": "observation", "importance_rule": "rule"}, "tags": ["knowledge_transfer"]},
      "llm_slots": {"plan_text": true, "dialogue": true, "narrative": true, "soft_judgment": {"dimension": "mentor_relation", "envelope_from": "D+R"}},
      "cost_class": "T1",
      "event_emit": ["ACTIVITY_STARTED", "ACTIVITY_COMPLETED", "SKILL_PRACTICE", "SKILL_LEVEL_UP", "NEED_UPDATE", "RELATION_CHANGE"]
