{
  "_comment": "PERCEPTION_SCOPE：event_type -> visibility_class（08 §3.5 R2 / §1.2 R5）。引擎侧 canonical 真源；版本纳入 engine_version 指纹。",
  "version": "v1.2-r2",
  "default_visibility_class": "place_local",
  "_class_semantics": {
    "_note": "08 §3.5 权威类语义（visibility_class → 判据字段集）。T266 裁定：D2 不含 payload.subject；D3 members 含 actor 回退。仅注释性真源（人读/对照），机器行为唯一实现在 contracts/visibility.py::visible()；三处（engine/perceive、life/visibility、adapter）只调用它，不内联。",
    "global": [],
    "place_local": ["e.place == location(agent, round)"],
    "members": ["group_members(group_id, round)", "payload.members", "actor"],
    "private": ["payload.from", "payload.to", "payload.to[]", "payload.agent_id", "payload.observer", "actor"],
    "participants_only": ["payload.participants", "payload.from", "payload.to", "actor"],
    "subject_only": ["payload.agent_id", "payload.observer", "payload.from", "actor"],
    "_dynamic": {"OFFER_CREATED": "to==[] -> global ; 否则 -> private (T137)"},
    "_known_gaps": ["G1 place_local 无 actor 回退(待裁)", "G2 部分 v2 新事件无 scope 条目(待补)", "G3 subject_only 含 from / private.to[] 与 OFFER_CREATED 特判重叠(待收敛)"]
  },
  "scope": {
    "MSG_PUBLIC": "global",
    "AGENT_DIED": "global",
    "SEED_EVENT": "global",
    "TIME_MARK": "global",

    "MSG_DM": "private",

    "MSG_GROUP": "members",

    "TRANSFER": "participants_only",
    "MARKET_TRADE": "participants_only",
    "RELATION_CHANGE": "participants_only",
    "LLM_JUDGMENT": "participants_only",

    "PLACE_MOVE": "place_local",
    "PLACE_ARRIVED": "place_local",
    "ACTIVITY_STARTED": "place_local",
    "ACTIVITY_COMPLETED": "place_local",
    "ACTIVITY_INTERRUPTED": "place_local",
    "RELATION_ENCOUNTER": "place_local",
    "STATE_CHANGE": "place_local",

    "OBSERVATION": "subject_only",
    "SCHEDULE_PLANNED": "subject_only",
    "SCHEDULE_REVISED": "subject_only",
    "NEED_UPDATE": "subject_only",
    "MEMORY_WRITE": "subject_only",
    "MEMORY_RETRIEVE": "subject_only",
    "MEMORY_REFLECT": "subject_only",
    "GOAL_SET": "subject_only",
    "GOAL_PROGRESS": "subject_only",
    "GOAL_ACHIEVED": "subject_only",
    "GOAL_ABANDON": "subject_only",
    "LLM_CALL": "subject_only"
  }
}
