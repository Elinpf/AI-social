   "rows": [
    {
     "thread": "m:T|TH-P007-P005-19",
     "prev_seq": 26537,
     "cur_seq": 27718,
     "round": 21,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "刚把李木匠家小子的退烧药包好，手上还沾着药碾子的苦味，你搁下的陈皮我瞧见了，先搁着吧，等会儿拿它煮水正好压压我这空了一上午的胃，你铺子那边今天进的货都归置妥了没？",
     "cur_body": "陈医，我那铺子后头还堆着两筐新到的山货没拆呢，等会儿回去再慢慢归置吧。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P009-P004-0",
     "prev_seq": 124,
     "cur_seq": 675,
     "round": 1,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "秀娘，你家那口子这阵子还咳得厉害吗？账要平。",
     "cur_body": "哎，他咳得轻些了，我刚把炉子里的桂圆红枣糕翻了个面，等会儿给金先生你切一块尝尝。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P001-18",
     "prev_seq": 28277,
     "cur_seq": 29483,
     "round": 22,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "锄头搁田埂上不怕丢，我这儿正给桂英家择韭菜呢，她明儿办席。你手没洗就先歇歇。",
     "cur_body": "我刚把西头那块田的排水沟清完，裤腿上全是泥，你给桂英家择韭菜这事我听着呢。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P016-0",
     "prev_seq": 156,
     "cur_seq": 1632,
     "round": 1,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": -1,
     "same_polarity": true,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "兰姐，我这几天在家腌那坛萝卜，盐放多了有点发苦，想问问你以前是怎么弄的。你教教我。",
     "cur_body": "哎，我正翻着刘家那筐新到的干辣椒，你腌萝卜发苦啊，是盐下早了。头道水先泡两个钟头，捞出来晾半干再码盐。你试试。",
     "tier_loose": true,
     "tier_loose_no_agree": true,
     "tier_polarity_match": true,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P016-0",
     "prev_seq": 1632,
     "cur_seq": 2196,
     "round": 3,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "哎，我正翻着刘家那筐新到的干辣椒，你腌萝卜发苦啊，是盐下早了。头道水先泡两个钟头，捞出来晾半干再码盐。你试试。",
     "cur_body": "哟，我正搓着周家送来的那簸箕萝卜条呢，听你这么一说，那我下回先泡足钟头再晾。盐得晚点撒。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P016-P002-7",
     "prev_seq": 16947,
     "cur_seq": 17418,
     "round": 11,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "手都磨出泡了还惦记蒜。我这儿刚剥了一辫子，你拿两头去，回头把萝卜汤盛一碗给巷口老周家孙子，那孩子这两天咳得厉害。",
     "cur_body": "哎，蒜我拿两头，萝卜汤盛出来先给老周家孙子晾着。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P016-P005-0",
     "prev_seq": 5096,
     "cur_seq": 5893,
     "round": 7,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "刚把新到的陈皮翻晒完，风一吹满摊子都是那股子苦香，陈医你那戥子称完当归，手也该歇歇了。称得准。",
     "cur_body": "这戥子一响啊，倒让我想起年轻时跟师父练功，一站就是半炷香，腿肚子直打颤呢。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    }
   ]
