      "speaker": "老周",
      "tags": [
       "gift"
      ],
      "to": "P003"
     },
     {
      "body": "（推了推袋子）老周，这……你家也不宽裕，我拿回去心里不踏实。",
      "channel": "dm",
      "day": 0,
      "from": "P003",
      "hearer": "老周",
      "msg_uid": "42:794",
      "place": "plaza",
