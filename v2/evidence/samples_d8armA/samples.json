     ],
     "to": "P001"
    },
    {
     "body": "（抹了把汗）饿就对了，说明没偷懒。再来一趟，练完我灶上还热着粥。",
     "channel": "dm",
     "day": 2,
     "from": "P001",
     "hearer": "阿禾",
     "msg_uid": "42:3419",
     "place": "market",
     "reply_to": "42:3323",
     "round": 28,
     "seq": 3419,
     "slot": "afternoon",
     "speaker": "老周",
     "tags": [
      "combat_training"
     ],
     "to": "P003"
    },
    {
     "body": "（喘着气）老周，这趟练完我真得回去做饭了，家里灶还凉着呢。",
     "channel": "dm",
     "day": 2,
     "from": "P003",
     "hearer": "老周",
     "msg_uid": "42:3520",
     "place": "cafe",
     "reply_to": "42:3419",
     "round": 30,
     "seq": 3520,
     "slot": "evening",
     "speaker": "阿禾",
     "tags": [
      "combat_training"
     ],
     "to": "P001"
    },
    {
     "body": "（抹了把汗）练完就回吧，地里的活还等着我呢。",
     "channel": "dm",
     "day": 2,
     "from": "P001",
     "hearer": "阿禾",
     "msg_uid": "42:3646",
     "place": "cafe",
     "reply_to": "42:3520",
     "round": 31,
     "seq": 3646,
     "slot": "evening",
     "speaker": "老周",
     "tags": [
