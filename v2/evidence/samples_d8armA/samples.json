   "n_msgs": 6,
   "peer_named_msgs": 2,
   "ptr_msgs": 5,
   "signals": 3,
   "thread_key": "T:TH-P001-P003-6",
   "turns_A": 6
  },
  {
   "chain_alternation": 6,
   "chain_mismatch": 0,
   "chain_pointer": 6,
   "grade": "good",
   "messages": [
    {
     "body": "（低头刨木，没看你）秀娘，这块料……你摸摸，顺不顺？",
     "channel": "dm",
     "day": 2,
     "from": "P002",
     "hearer": "秀娘",
     "msg_uid": "42:3515",
     "place": "cafe",
     "reply_to": null,
     "round": 30,
     "seq": 3515,
     "slot": "evening",
     "speaker": "老石",
     "tags": [
      "whisper"
     ],
     "to": "P004"
    },
    {
     "body": "（伸手摸了摸木料，指尖顺着纹路滑过去）哎哟，真顺溜，跟刚出炉的馒头似的，摸着就舒坦。老石，你这手艺，我服。",
     "channel": "dm",
     "day": 2,
     "from": "P004",
     "hearer": "老石",
     "msg_uid": "42:3780",
     "place": "cafe",
     "reply_to": "42:3515",
     "round": 31,
     "seq": 3780,
     "slot": "evening",
     "speaker": "秀娘",
     "tags": [
      "whisper"
     ],
     "to": "P002"
    },
    {
     "body": "（头也不抬，继续推刨）嗯。木头认人，你待它细，它就顺。",
     "channel": "dm",
     "day": 2,
     "from": "P002",
     "hearer": "秀娘",
     "msg_uid": "42:4027",
     "place": "residence",
     "reply_to": "42:3780",
     "round": 33,
     "seq": 4027,
     "slot": "night",
     "speaker": "老石",
     "tags": [
      "whisper"
     ],
     "to": "P004"
    },
    {
     "body": "（把围裙往腰后一掖，凑近半步）哎哟，老石，你这木头经我听着都馋了。我今儿新烤了一炉桂花糖糕，边角有点焦，正想着给谁尝尝呢——你歇会儿手，来一块？",
     "channel": "dm",
     "day": 2,
     "from": "P004",
     "hearer": "老石",
     "msg_uid": "42:4677",
     "place": "residence",
     "reply_to": "42:4027",
     "round": 34,
     "seq": 4677,
     "slot": "night",
     "speaker": "秀娘",
     "tags": [
      "whisper"
     ],
     "to": "P002"
    },
    {
     "body": "（手上刨子没停）不了，这块料得赶完。",
     "channel": "dm",
     "day": 3,
     "from": "P002",
     "hearer": "秀娘",
     "msg_uid": "42:4855",
     "place": "workshop",
     "reply_to": "42:4677",
     "round": 36,
     "seq": 4855,
     "slot": "morning",
     "speaker": "老石",
     "tags": [
      "whisper"
     ],
     "to": "P004"
    },
    {
     "body": "（把围裙往腰后一系，凑近两步）哎哟，老石，你这刨花卷得跟面包卷似的，香不香啊？——说正经的，我今儿试了个新方子，桂花酒酿小圆子，甜得刚好，不齁。你歇口气，尝一碗？",
     "channel": "dm",
     "day": 3,
     "from": "P004",
     "hearer": "老石",
     "msg_uid": "42:5038",
     "place": "farm",
     "reply_to": "42:4855",
     "round": 37,
     "seq": 5038,
     "slot": "morning",
     "speaker": "秀娘",
     "tags": [
      "whisper"
     ],
     "to": "P002"
    }
   ],
