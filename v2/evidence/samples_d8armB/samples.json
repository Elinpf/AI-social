    "grade": "good",
    "messages": [
     {
      "body": "（擦汗）阿禾，这练法太花哨，我庄稼把式只认一个稳字。",
      "channel": "dm",
      "day": 2,
      "from": "P001",
      "hearer": "阿禾",
      "msg_uid": "42:3192",
      "place": "park",
      "reply_to": null,
      "round": 25,
      "seq": 3192,
      "slot": "morning",
      "speaker": "老周",
      "tags": [
       "combat_training"
      ],
      "to": "P003"
     },
     {
      "body": "（喘气）老周，稳是稳，可这练法我肚子饿得慌，先歇会儿吧。",
      "channel": "dm",
      "day": 2,
      "from": "P003",
      "hearer": "老周",
      "msg_uid": "42:3362",
      "place": "farm",
      "reply_to": "42:3192",
      "round": 27,
      "seq": 3362,
      "slot": "afternoon",
      "speaker": "阿禾",
      "tags": [
       "combat_training"
      ],
      "to": "P001"
     },
     {
      "body": "（抹了把汗）歇不得，天快黑了。再练一趟，回去我给你煮碗面。",
      "channel": "dm",
      "day": 2,
      "from": "P001",
      "hearer": "阿禾",
      "msg_uid": "42:3458",
      "place": "market",
      "reply_to": "42:3362",
      "round": 28,
      "seq": 3458,
      "slot": "afternoon",
      "speaker": "老周",
      "tags": [
       "combat_training"
      ],
      "to": "P003"
     },
     {
      "body": "（喘着气）行，再练一趟。不过老周，你那面得多下点，我今儿饿得慌。",
      "channel": "dm",
      "day": 2,
      "from": "P003",
      "hearer": "老周",
      "msg_uid": "42:3559",
      "place": "cafe",
      "reply_to": "42:3458",
      "round": 30,
      "seq": 3559,
      "slot": "evening",
      "speaker": "阿禾",
      "tags": [
       "combat_training"
      ],
      "to": "P001"
     },
     {
      "body": "（抹了把汗）面我揉好了，搁灶上醒着呢。练完这趟就下锅。",
      "channel": "dm",
      "day": 2,
      "from": "P001",
      "hearer": "阿禾",
      "msg_uid": "42:3689",
      "place": "cafe",
      "reply_to": "42:3559",
      "round": 31,
      "seq": 3689,
      "slot": "evening",
      "speaker": "老周",
      "tags": [
       "combat_training"
      ],
      "to": "P003"
     },
     {
      "body": "（点头）嗯，练完再吃。老周，这趟练完，我想跟你商量个事。",
      "channel": "dm",
      "day": 2,
      "from": "P003",
      "hearer": "老周",
      "msg_uid": "42:4233",
      "place": "residence",
      "reply_to": "42:3689",
      "round": 33,
      "seq": 4233,
      "slot": "night",
      "speaker": "阿禾",
      "tags": [
       "combat_training"
      ],
      "to": "P001"
     }
    ],
    "n_msgs": 6,
    "peer_named_msgs": 4,
    "ptr_msgs": 5,
    "signals": 3,
