          "to": "P007",
          "group_id": null,
          "turn_index": 0,
          "reply_to": null,
          "msg_uid": "42:37616",
          "body": "（蹲在田埂上，头也不抬）阿林，你那套新法子我不试，地还是按老规矩种。",
          "ctx": {
            "initiator": "P001",
            "mood": "紧绷",
            "need": {
              "leisure": 0
            },
            "relation": 3,
            "topic": "counter_propose",
            "trigger": "counter_propose"
