          "type": "MSG_DM",
          "from": "P001",
          "to": "P005",
          "group_id": null,
          "turn_index": 4,
          "reply_to": "42:62214",
          "msg_uid": "42:64017",
          "body": "（坐下，把袖子撸上去）量就量。陈医，我听说镇上化肥要断货了，真的假的？",
          "ctx": {
            "initiator": "P001",
            "mood": "紧绷",
            "need": {
              "leisure": 0
            },
            "relation": 3,
            "topic": "scarce_buy",
            "trigger": "reply"
          }
        },
