          "group_id": null,
          "turn_index": 1,
          "reply_to": "42:59202",
          "msg_uid": "42:60054",
          "body": "（把药箱往田埂上一放，慢慢蹲下来）抢不赢也得抢，地里的苗等不起。我这儿还有两瓶葡萄糖，你要是撑不住就喝一口。",
          "ctx": {
            "initiator": "P001",
            "mood": "紧绷",
            "need": {
              "leisure": 0
            },
            "relation": 3,
            "topic": "scarce_buy",
            "trigger": "reply"
