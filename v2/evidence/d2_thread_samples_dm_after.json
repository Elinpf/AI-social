          "type": "MSG_DM",
          "from": "P005",
          "to": "P001",
          "group_id": null,
          "turn_index": 5,
          "reply_to": "42:64017",
          "msg_uid": "42:79556",
          "body": "（把血压计袖带缠上，动作不紧不慢）先别动，深呼吸。化肥的事我听说了，供销社那边确实紧张，但还没到断的地步。你这血压……最近是不是又没睡好？",
          "ctx": {
            "initiator": "P001",
            "mood": "紧绷",
            "need": {
              "leisure": 0
            },
            "relation": 3,
            "topic": "scarce_buy",
            "trigger": "reply"
