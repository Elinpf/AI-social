          "turn_index": 0,
          "reply_to": null,
          "msg_uid": "42:59202",
          "body": "（蹲在田埂上，捏着烟没点）今年这水，怕是抢不赢上游了。",
          "ctx": {
            "initiator": "P001",
            "mood": "紧绷",
            "need": {
              "leisure": 0
            },
            "relation": 3,
            "topic": "scarce_buy",
