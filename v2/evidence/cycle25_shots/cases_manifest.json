      "msgs": [
        {
          "body": "手一闲下来就爱瞎琢磨，刚把王婶家那破竹篮的提手换成藤条编的，结实又好看，回头你也试试呗。",
          "body_len": 44,
          "day": 0,
          "from": "P014",
          "line": 1448,
          "msg_uid": "43:1447",
