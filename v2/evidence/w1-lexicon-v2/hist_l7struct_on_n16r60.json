              "reason": "no_weather_phrase",
              "matched": []
            }
          ],
          "v2_borderline_only": false,
          "body": "哎，当归的事你顺嘴问问就成，我这儿先把赵家老太太这页抄完，笔尖还湿着。你去吧。"
        },
        {
          "msg_uid": "42:32926",
          "day": 1,
          "legacy_words": [
