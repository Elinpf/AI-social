              "matched": [
                "晒场"
              ]
            }
          ],
          "v2_borderline_only": false,
          "body": "哟，我刚把晒场边那根竹竿绑上旧布条当靶子，你削木鸟时顺手给我留个尖嘴的。"
        },
        {
          "msg_uid": "42:2262",
          "day": 0,
          "legacy_words": [
            "晒"
          ],
          "v2_is_weather": false,
          "v2_kept_strong": [],
