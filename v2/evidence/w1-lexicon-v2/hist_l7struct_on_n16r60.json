          ],
          "v2_kept_phrases": [
            "风吹"
          ],
          "v2_dropped": [],
          "v2_borderline_only": false,
          "body": "我正拿粉笔在操场地上画格子，画到一半被风吹得歪歪扭扭，赵家小孙子蹲旁边拿陀螺蹭我线。你那麻绳先借我量量格子。别磨了。"
        },
        {
          "msg_uid": "42:12896",
          "day": 0,
          "legacy_words": [
            "风"
          ],
          "v2_is_weather": false,
          "v2_kept_strong": [],
          "v2_kept_words": [],
          "v2_kept_phrases": [],
