              "reason": "no_weather_phrase",
              "matched": []
            }
          ],
          "v2_borderline_only": false,
          "body": "这山货晒得正好呢，我摊上还压着两斤干笋没摆出来，你先忙王家小孙子的药吧。"
        },
        {
          "msg_uid": "42:6421",
          "day": 0,
          "legacy_words": [
            "晒"
          ],
          "v2_is_weather": false,
          "v2_kept_strong": [],
