   "rows": [
    {
     "thread": "m:T|TH-P008-P007-6",
     "prev_seq": 12904,
     "cur_seq": 19341,
     "round": 12,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把手里那半块干饼掰下一角，饼渣掉在户籍册边上）布搁你这儿我放心，可我这肚子先不答应了——晌午到现在就啃了这么点。你家灶上还留着火没？",
     "cur_body": "（合上户籍册，指尖在封皮上按了按）灶上还温着半锅粥，你嫂子给留的。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P011-P008-12",
     "prev_seq": 21967,
     "cur_seq": 22907,
     "round": 16,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把刚啃了两口的冷馍搁在册子边上，拍了拍手上的渣）我正啃馍呢，饿得云手都画成圈了——周叔你先别笑，王家老三那迁出单子我瞄了一眼，字写得比我还歪。比划两下就两下。",
     "cur_body": "（把迁出单子往桌上一摊，指头点着王家老三那行字）我这正核着王家老三的迁出单子呢，饿得手都发飘，你那冷馍掰我半块垫垫吧。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P001-18",
     "prev_seq": 28308,
     "cur_seq": 29522,
     "round": 22,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（蹲在灶前添柴，锅里水刚冒泡）西坡那玉米是旱得厉害，老刘家小子昨儿还帮我挑了两桶水呢。（起身拍拍围裙）你等着，我给你下碗面。",
     "cur_body": "（把锄头靠在门框上，鞋底还沾着泥）我刚从西坡回来，顺手掰了个老刘家的嫩玉米，你给煮上吧。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P015-4",
     "prev_seq": 4766,
     "cur_seq": 5044,
     "round": 6,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把灶上那锅萝卜炖肉的火拧小，拿筷子戳了戳肉皮）桂婶，我这正愁萝卜放多了汤发苦呢，你手里那缨子给我两把，我焯完剁碎了拌进肉馅里，回头蒸一屉包子给你端过去。",
     "cur_body": "（把萝卜缨子往灶台边一搁，顺手掐掉两根黄叶）五味，缨子给你撂这儿了，蒸包子多搁点姜末。趁热吃。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P012-P015-4",
     "prev_seq": 7127,
     "cur_seq": 7815,
     "round": 8,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（拿围裙角擦了擦手，接过缨子抖了抖根上的土）姜末我记着呢，就是这肉馅今早剁得粗，怕蒸出来不够抱团，回头掺把虾皮提提鲜吧。",
     "cur_body": "（把灶上蒸笼盖掀开一条缝，白汽扑脸）哎，五味，你上回给东头老周家捎的那把虾皮，他家媳妇还念叨鲜呢。掺上正好。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P016-P005-0",
     "prev_seq": 2262,
     "cur_seq": 3271,
     "round": 4,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把摊上那捆麻绳往边上挪了挪）这陈皮压成饼倒不打紧，就怕串了潮气，你掰开闻闻有没有霉味儿吧。",
     "cur_body": "（捏起一片陈皮凑近鼻尖）这味儿倒还正，就是边角有点返软了。兰姐你摸摸，像不像前街王婶晒的那批，回潮了就这手感吧。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P016-P015-16",
     "prev_seq": 28619,
     "cur_seq": 32140,
     "round": 22,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（手背蹭了下围裙上的酱渍，锅铲还攥在手里）腌萝卜方子你先别念，我那灶上酱肉收汁就这一会儿，火候过了发苦——你收摊路过时敲下后窗，我把灶边那半碗剩饭热给你，你顺嘴再说。",
     "cur_body": "（把摊上最后两把韭菜拢进竹篮，叶尖还挂着水珠）五味啊，你那酱肉我闻着都香，可我这儿韭菜再不放就蔫了，得先给张屠户家送过去呢。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    }
   ]
  },
