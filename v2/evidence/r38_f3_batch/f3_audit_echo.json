   "rows": [
    {
     "thread": "m:T|TH-P007-P005-19",
     "prev_seq": 26547,
     "cur_seq": 27736,
     "round": 21,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把捣药杵搁下，药碾里还留着半截黄芪）刚给东头老周家孙子碾完药，手上这味儿还没散呢。你这一路过来，肚子怕是也空着吧？",
     "cur_body": "陈医，你闻闻我这袖口，还沾着西街王屠户家案板上的油腥气呢，你这一碾药碾到这会儿，肚子早该咕咕叫了吧。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P008-P007-6",
     "prev_seq": 19329,
     "cur_seq": 20669,
     "round": 13,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把毛笔搁在砚台沿上，笔尖滴下一小点墨）这盐价一涨，老陈家那锅豆腐怕是淡得能照见人影了。我这儿还核着东街的户籍册，纸都翻毛了边。",
     "cur_body": "（把账本往膝头一合，指头还沾着盐粒）淡得照见人影——这话我信，我昨儿在码头扛盐包，麻袋角漏的那点都够我舔一路。老陈家的豆腐要是真淡了，他家小栓子准得蹲门口哭。你那户籍册翻毛了边，是东街哪一户又添了丁？",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P008-P007-7",
     "prev_seq": 13360,
     "cur_seq": 19258,
     "round": 12,
     "cur_is_reply": true,
     "p_prev": -1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把砚台边那摞户籍册又码齐，指头沾着墨）阿林，我这儿刚给西街孙家小子补完一份迁出文书，墨还没干透呢——你称完黄豆，肚子怕是也空了吧？",
     "cur_body": "哎，周公文，你这墨味儿一飘，我肚子倒真咕噜上了。（把秤杆往黄豆袋上一搁，搓了搓手上的灰）西街孙家那小子，前儿还见他蹲在门口啃烧饼呢，这就迁走啦？",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    },
    {
     "thread": "m:T|TH-P009-P004-0",
     "prev_seq": 124,
     "cur_seq": 675,
     "round": 1,
     "cur_is_reply": true,
     "p_prev": 1,
     "p_cur": 0,
     "same_polarity": false,
     "markers": [],
     "genuine_markers": [],
     "no_agree_markers": [],
     "prev_body": "（把算盘珠子拨回原位）秀娘，你家那口子今早来柜上支钱，说是要修屋顶——这阵子雨水多，漏得厉害吧？账要平。",
     "cur_body": "（把沾了面粉的手在围裙上蹭了蹭）哎，漏是漏，昨儿后半夜滴答滴答的，我起来拿搪瓷盆接了两回。金先生您这账平得对，回头我让他把瓦片钱单记一张，省得跟面钱搅一块儿。",
     "tier_loose": false,
     "tier_loose_no_agree": false,
     "tier_polarity_match": false,
     "tier_marker_based": false
    }
   ]
  }
 ]
